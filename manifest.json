{
  "manifest_version": 3,
  "name": "Google Search Tabs Keeper",
  "version": "1.0.0",
  "description": "Google検索でショッピングを開いた後も検索種別のナビゲーションを表示します。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.google.co.jp/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
